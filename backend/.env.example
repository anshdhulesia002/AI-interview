# Environment & Server Config
PORT=5000
NODE_ENV=production
CORS_ORIGIN=https://interview-ai.vercel.app

# MongoDB Atlas Database Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/interview_ai?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=your_super_secret_production_jwt_key_here
JWT_EXPIRY=7d
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_here
REFRESH_TOKEN_EXPIRY=30d

# Google Gemini AI API Credentials (@google/genai)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
